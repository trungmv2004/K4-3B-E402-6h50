# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model used for quiz generation, grading, tutor chat and video transcription.
# Optional — defaults to gemini-3.6-flash. GEMINI_FALLBACK_MODEL is a comma-separated list tried in order when a model hits its daily free-tier quota or is overloaded.
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# GEMINI_LIGHT_MODEL: lightweight models (comma-separated) for tutor chat, grading and evidence check — faster and cheaper.
GEMINI_LIGHT_MODEL="gemini-3.5-flash-lite,gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
